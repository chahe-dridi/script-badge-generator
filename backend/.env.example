# Copy to .env and adjust. Never commit the real .env.

# Database — SQLite locally; use a Postgres URL in production, e.g.
#   postgresql+psycopg2://user:pass@host:5432/badgegen
DATABASE_URL=sqlite:///./badgegen.db

# Auth — MUST set a strong random value in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# CORS — comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000
